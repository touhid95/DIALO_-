# Copy to `.env` and fill in. Never commit .env.

# ---------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------
# Apollo API key from https://app.apollo.io/#/settings/api-key.
# contacts/search needs the `contacts_search` scope for the lookup phase.
APOLLO_API_KEY=

# Public HTTPS endpoint that receives async phone results (run
# `python cli.py webhook`, or use webhook.site for testing). Required when
# REVEAL_PHONE_NUMBER is true.
WEBHOOK_URL=https://yourdomain.com/webhooks/apollo

# ---------------------------------------------------------------
# STEP 1 - LOOKUP PHASE (0 credits) via api/v1/contacts/search
# ---------------------------------------------------------------
# Search your team's saved contacts database.
# q_keywords / contact stage & label ids are sent server-side; location and
# domain filters (CLIENT_LOCATIONS / ORGANIZATION_DOMAINS) run client-side
# because contacts/search does not accept them.
KEYWORDS=
CONTACT_STAGE_IDS=
CONTACT_LABEL_IDS=

# Client-side filters applied to the returned contacts array.
CLIENT_LOCATIONS=
ORGANIZATION_DOMAINS=

# Strict routing rule: only isolate entries where has_direct_phone == "Yes".
# Set false to route every phone-less contact to enrichment.
FILTER_HAS_DIRECT_PHONE=true
# Route entries with has_direct_phone == "Maybe" as well.
INCLUDE_MAYBE_PHONE=false

# ---------------------------------------------------------------
# STEP 2 - REVEAL PHASE (credit consuming) - trigger strategy
# ---------------------------------------------------------------
# match    = POST /api/v1/people/match  (direct fallback reveal)
# sequence = POST /api/v1/emailer_campaigns/{id}/add_contact_ids
# agent    = POST /api/v1/agents/task   (bulk background extraction loop)
TRIGGER_MODE=match

# Used by TRIGGER_MODE=sequence / agent
SEQUENCE_ID=
SEND_FROM_EMAIL_ACCOUNT_ID=
AGENT_ID=

# People/match reveal flags (TRIGGER_MODE=match)
REVEAL_PHONE_NUMBER=true
RUN_WATERFALL_PHONE=true
REVEAL_PERSONAL_EMAILS=false
RUN_WATERFALL_EMAIL=false

# ---------------------------------------------------------------
# STEP 3 - CALLBACK MONITORING
#   status = GET /api/v1/people/phone_enrichment_status  (waterfall checks)
#   webhook = GET /api/v1/webhook_result/show            (historical pull)
# ---------------------------------------------------------------
MONITOR_PRIORITY=status
POLL_INTERVAL_SECONDS=15
POLL_MAX_WAIT_SECONDS=1800
APOLLO_REQUEST_INTERVAL=1.0

# ---------------------------------------------------------------
# WEBHOOK RECEIVER (python cli.py webhook)
# ---------------------------------------------------------------
WEBHOOK_PORT=5000
# Optional shared secret checked against header `x-apollo-signature`
WEBHOOK_SECRET=

# ---------------------------------------------------------------
# PAGINATION / SAFETY
# ---------------------------------------------------------------
PAGE=1
PER_PAGE=25
MAX_PAGES=1
# Set true to log every Step-2 dispatch target without calling the API.
DRY_RUN=false