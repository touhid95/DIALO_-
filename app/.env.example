# ==============================================================================
# AI Lead Intelligence & Chatbot Module Environment Variables
# ==============================================================================

# OpenRouter API Key (Required for live AI reasoning & multimodal analysis)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default Model (Fallback chain: Nemotron 30b -> Gemini 2.5 Flash -> Llama 3.3 70b)
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# CALL-E Voice Qualification Agent (Optional)
# Modes: "synthetic" (default simulation) | "live"
CALL_MODE=synthetic
CALL_E_API_KEY=

# Meta WhatsApp Business Cloud API (Optional - for WhatsApp Channel)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Telegram Bot API (Optional - for Telegram Channel)
TELEGRAM_BOT_TOKEN=
